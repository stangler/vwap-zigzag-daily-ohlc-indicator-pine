//@version=6
indicator("統合版：VWAP & Zig Zag & 単日四本値", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

import DevLucem/ZigLib/1 as ZigZag

VWAP_GROUP = "期間別VWAP設定"
BANDS_GROUP = "バンド設定"
MA_GROUP = "移動平均線設定"
DAILY_GROUP = "単日四本値設定"
COLOR_GROUP = "色設定"
LABEL_GROUP = "ラベル・テーブル設定"
PREV_HTF_GROUP = "前日の四本値設定"
ZIGZAG_GROUP = "Zig Zag設定"
ZZ_LINE_GROUP = "Zig Zag ライン設定"
ZZ_LABEL_GROUP = "Zig Zag ラベル設定"
ZZ_COLOR_GROUP = "Zig Zag 色設定"
SMA_GROUP = "SMA設定（期間可変）"
SMA_SMOOTH_GROUP = "SMAスムージング設定"

hideonDWM = input(true, title="日足以上ではVWAPを非表示", group=VWAP_GROUP, display=display.data_window)
offset_vwap = input.int(0, title="オフセット", group=VWAP_GROUP, minval=0, display=display.data_window)
vwap_line_color = input.color(color.aqua, "VWAPラインの色", group=VWAP_GROUP)
vwap_line_width = input.int(2, "VWAPラインの太さ", group=VWAP_GROUP, minval=1, maxval=5)

showBand_1 = input(true, title="", group=BANDS_GROUP, inline="band_1", display=display.data_window)
bandMult_1 = input.float(1.0, title="バンド乗数 #1", group=BANDS_GROUP, inline="band_1", step=0.5, minval=0, display=display.data_window, active=showBand_1)
band1_color = input.color(color.green, "バンド #1の色", group=BANDS_GROUP, inline="band_1_color")
band1_width = input.int(1, "バンド #1の太さ", group=BANDS_GROUP, inline="band_1_width", minval=1, maxval=5)
band1_fill_color = input.color(color.new(color.green, 95), "バンド #1の塗りつぶし", group=BANDS_GROUP, inline="band_1_color")

show_ma5 = input.bool(true, "5本移動平均線を表示", group=MA_GROUP)
ma5_color = input.color(color.red, "5本MAの色", group=MA_GROUP)
ma5_width = input.int(2, "5本MAの太さ", group=MA_GROUP, minval=1, maxval=5)
show_ma20 = input.bool(true, "20本移動平均線を表示", group=MA_GROUP)
ma20_color = input.color(color.yellow, "20本MAの色", group=MA_GROUP)
ma20_width = input.int(2, "20本MAの太さ", group=MA_GROUP, minval=1, maxval=5)
ma_source = input.source(close, "MA計算ソース", group=MA_GROUP)
show_sma = input.bool(true, "SMAを表示", group=SMA_GROUP)
sma_len = input.int(10, "SMA期間", minval=1, group=SMA_GROUP)
sma_src = input.source(close, "SMAソース", group=SMA_GROUP)
sma_offset = input.int(0, "SMAオフセット", minval=-500, maxval=500, group=SMA_GROUP, display=display.none)
sma_color = input.color(color.blue, "SMAの色", group=SMA_GROUP)
sma_width = input.int(1, "SMAの太さ", minval=1, maxval=5, group=SMA_GROUP)
sma_ma_type = input.string("None", "スムージング種類", options=["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=SMA_SMOOTH_GROUP, display=display.none)
sma_ma_len = input.int(14, "スムージング期間", minval=1, group=SMA_SMOOTH_GROUP, display=display.none, active=sma_ma_type != "None")
sma_bb_mult = input.float(2.0, "BB標準偏差", minval=0.001, maxval=50, step=0.5, group=SMA_SMOOTH_GROUP, tooltip="「SMA + Bollinger Bands」選択時のみ有効。SMAとバンドの距離を決めます。", display=display.none, active=sma_ma_type == "SMA + Bollinger Bands")
sma_color_ma = input.color(color.yellow, "スムージングMAの色", group=SMA_SMOOTH_GROUP)
sma_color_bb = input.color(color.green, "BBの色", group=SMA_SMOOTH_GROUP)

target_date_raw = input.int(0, "表示対象日 (YYYYMMDD、0=当日)", group=DAILY_GROUP, minval=0, maxval=20991231)
use_custom_start = input.bool(true, "開始時刻を固定する", group=DAILY_GROUP)
start_hour = input.int(6, "開始時刻（時）", minval=0, maxval=23, group=DAILY_GROUP)
start_minute = input.int(0, "開始時刻（分）", minval=0, maxval=59, group=DAILY_GROUP)
start_tz = input.string("Asia/Tokyo", "開始時刻のタイムゾーン", options=["Asia/Tokyo", "America/New_York", "Europe/London", "UTC"], group=DAILY_GROUP)

// 開始時刻を基準にした「セッション日付」（開始時刻から24時間を1日として扱う）
start_offset_ms = (start_hour * 60 + start_minute) * 60 * 1000
shifted_time = time - start_offset_ms
session_date = use_custom_start ? year(shifted_time, start_tz) * 10000 + month(shifted_time, start_tz) * 100 + dayofmonth(shifted_time, start_tz) : year * 10000 + month * 100 + dayofmonth
today_date = session_date
target_date = target_date_raw == 0 ? today_date : target_date_raw

show_daily_ohlc_input = input.bool(true, "四本値を表示", group=DAILY_GROUP)
show_daily_ohlc = timeframe.isdwm ? false : show_daily_ohlc_input

open_color = input.color(color.white, "始値の色", group=COLOR_GROUP)
high_color = input.color(color.green, "高値の色", group=COLOR_GROUP)
low_color = input.color(color.red, "安値の色", group=COLOR_GROUP)
close_color = input.color(color.gray, "終値の色", group=COLOR_GROUP)
daily_vwap_color = input.color(color.aqua, "単日VWAPの色", group=COLOR_GROUP)
line_width = input.int(2, "ライン幅", minval=1, maxval=5, group=COLOR_GROUP)

show_labels = input.bool(false, "価格ラベルを表示", group=LABEL_GROUP)
label_offset = input.int(10, "ラベルオフセット", minval=0, maxval=50, group=LABEL_GROUP)
show_table = input.bool(true, "情報テーブルを表示", group=LABEL_GROUP)
table_position = input.string("左下", "テーブル位置", options=["右上", "左上", "右下", "左下"], group=LABEL_GROUP)

show_prev_htf_input = input.bool(true, "前日の四本値を表示", group=PREV_HTF_GROUP)
show_prev_htf = timeframe.isdwm ? false : show_prev_htf_input
prev_htf_open_color = input.color(color.white, "前日始値の色", group=PREV_HTF_GROUP)
prev_htf_close_color = input.color(color.gray, "前日終値の色", group=PREV_HTF_GROUP)
prev_htf_high_color = input.color(color.green, "前日高値の色", group=PREV_HTF_GROUP)
prev_htf_low_color = input.color(color.red, "前日安値の色", group=PREV_HTF_GROUP)
prev_htf_line_width = input.int(1, "前日ラインの太さ", minval=1, maxval=5, group=PREV_HTF_GROUP)
show_prev_labels = input.bool(false, "前日四本値のラベルを表示", group=PREV_HTF_GROUP)

// ===== 追加：前日大引けVWAPライン設定 =====
show_prev_vwap_close_input = input.bool(true, "前日大引けVWAPを表示", group=PREV_HTF_GROUP)
show_prev_vwap_close = timeframe.isdwm ? false : show_prev_vwap_close_input
prev_vwap_close_color = input.color(color.aqua, "前日VWAPの色", group=PREV_HTF_GROUP)
prev_vwap_close_width = input.int(2, "前日VWAPの太さ", minval=1, maxval=5, group=PREV_HTF_GROUP)

show_zigzag = input.bool(true, "Zig Zagを表示", group=ZIGZAG_GROUP)
zzDepth = input.int(12, "Depth", minval=1, step=1, group=ZIGZAG_GROUP)
zzDeviation = input.int(5, "Deviation", minval=1, step=1, group=ZIGZAG_GROUP)
zzBackstep = input.int(2, "Backstep", minval=2, step=1, group=ZIGZAG_GROUP)
zzRepaint = input.bool(true, "リペイント（レベルを更新し続ける）", group=ZIGZAG_GROUP)
zzExtend = input.bool(false, "Zig Zagを右へ延長", group=ZZ_LINE_GROUP)
zzLineThick = input.int(2, "ライン太さ", minval=1, maxval=4, group=ZZ_LINE_GROUP)
zzLineTransp = input.int(0, "ライン透明度", minval=0, maxval=100, group=ZZ_LINE_GROUP)
zzShowLabels = input.bool(true, "HH/LH/HL/LLラベルを表示", group=ZZ_LABEL_GROUP)
zzLabelTransp = input.int(0, "ラベル透明度", minval=0, maxval=100, group=ZZ_LABEL_GROUP)
zzLabelTextColor = input.color(color.white, "ラベル文字色", group=ZZ_LABEL_GROUP)
zzLabelSize = switch input.int(3, "ラベルサイズ", minval=1, maxval=5, group=ZZ_LABEL_GROUP)
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge
zzUpColor = input.color(color.lime, "上昇の色", group=ZZ_COLOR_GROUP)
zzDnColor = input.color(color.red, "下降の色", group=ZZ_COLOR_GROUP)
zzShowBg = input.bool(true, "方向の背景色を表示", group=ZZ_COLOR_GROUP)
zzBgTransp = input.int(80, "背景透明度", minval=0, maxval=100, group=ZZ_COLOR_GROUP)

var float daily_open = na
var float daily_high = na
var float daily_low = na
var float daily_close = na
var float sum_price_volume = 0.0
var float sum_volume = 0.0
var float daily_vwap_value = na

var label open_label = na
var label high_label = na
var label low_label = na
var label close_label = na
var label daily_vwap_label = na

var float prevOpenHTF = na
var float prevCloseHTF = na
var float prevHighHTF = na
var float prevLowHTF = na
var line prevOpenHTF_line = na
var line prevCloseHTF_line = na
var line prevHighHTF_line = na
var line prevLowHTF_line = na

// ===== 追加：前日大引けVWAPライン用 =====
var float prevDayVWAPClose = na
var line  prevDayVWAPClose_line = na

var table info_table = na

// ===== Zig Zag++ [LD]（MT4 ZigZag準拠） =====
[zzDirection, zz1, zz2] = ZigZag.zigzag(low, high, zzDepth, zzDeviation, zzBackstep)
float zzP1Prev = na(zz1[1]) ? na : (zz1[1]).price
float zzP2 = na(zz2) ? na : zz2.price
float zzP2Prev = na(zz2[1]) ? na : (zz2[1]).price
string zzNowPoint = ""
var float zzLastPoint = zzP1Prev
if bool(ta.change(zzDirection))
    zzLastPoint := zzP1Prev

line zzLine = na
label zzPoint = na

if show_zigzag and not na(zz1) and not na(zz2)
    if zzRepaint
        zzLine := line.new(zz1, zz2, xloc.bar_time, zzExtend ? extend.right : extend.none, color.new(zzDirection > 0 ? zzUpColor : zzDnColor, zzLineTransp), width=zzLineThick)
        zzNowPoint := zzDirection < 0 ? (zzP2 < zzLastPoint ? "LL" : "HL") : (zzP2 > zzLastPoint ? "HH" : "LH")
        if zzShowLabels
            zzPoint := label.new(zz2, zzNowPoint, xloc.bar_time, yloc.price, color.new(zzDirection < 0 ? zzUpColor : zzDnColor, zzLabelTransp), zzDirection > 0 ? label.style_label_down : label.style_label_up, zzLabelTextColor, zzLabelSize)
        if zzDirection == zzDirection[1]
            line.delete(zzLine[1])
            label.delete(zzPoint[1])
        else
            line.set_extend(zzLine[1], extend.none)
    else
        if zzDirection != zzDirection[1]
            zzLine := line.new(zz1[1], zz2[1], xloc.bar_time, extend.none, color.new(zzDirection > 0 ? zzUpColor : zzDnColor, zzLineTransp), width=zzLineThick)
            zzNowPoint := zzDirection[1] < 0 ? (zzP2Prev < zzLastPoint[1] ? "LL" : "HL") : (zzP2Prev > zzLastPoint[1] ? "HH" : "LH")
            if zzShowLabels
                zzPoint := label.new(zz2[1], zzNowPoint, xloc.bar_time, yloc.price, color.new(zzDirection[1] < 0 ? zzUpColor : zzDnColor, zzLabelTransp), zzDirection[1] > 0 ? label.style_label_down : label.style_label_up, zzLabelTextColor, zzLabelSize)

bgcolor(show_zigzag and zzShowBg ? (zzDirection < 0 ? color.new(zzDnColor, zzBgTransp) : color.new(zzUpColor, zzBgTransp)) : na, title="Direction Background")
plotarrow(zzDirection, "direction", display=display.status_line)

alertcondition(zzNowPoint == "HH" and zzP2 != zzP2Prev, "New Higher High", "Zigzag on {{ticker}} higher high detected at {{time}}")
alertcondition(zzNowPoint == "LH" and zzP2 != zzP2Prev, "New Lower High", "Zigzag on {{ticker}} lower high detected at {{time}}")
alertcondition(zzNowPoint == "HL" and zzP2 != zzP2Prev, "New Higher Low", "Zigzag on {{ticker}} higher low detected at {{time}}")
alertcondition(zzNowPoint == "LL" and zzP2 != zzP2Prev, "New Lower Low", "Zigzag on {{ticker}} lower low detected at {{time}}")
alertcondition(zzDirection != zzDirection[1], "Direction Changed", "Zigzag on {{ticker}} direction changed at {{time}}")
alertcondition(zzDirection != zzDirection[1] and zzDirection > 0, "Bullish Direction", "Zigzag on {{ticker}} bullish direction at {{time}}")
alertcondition(zzDirection != zzDirection[1] and zzDirection < 0, "Bearish Direction", "Zigzag on {{ticker}} bearish direction at {{time}}")

if zzDirection != zzDirection[1]
    alert((zzDirection < 0 ? "Bearish" : "Bullish") + " Direction Final ", alert.freq_once_per_bar_close)

cumVolume = ta.cum(volume)
if barstate.islast and cumVolume == 0
    runtime.error("出来高データがありません。")

isNewPeriod = timeframe.change("D")
src_vwap = hlc3

float vwapValue = na
float upperBandValue1 = na
float lowerBandValue1 = na

if not (hideonDWM and timeframe.isdwm)
    [_vwap, _stdevUpper, _] = ta.vwap(src_vwap, isNewPeriod, 1)
    vwapValue := _vwap
    stdevAbs = _stdevUpper - _vwap
    upperBandValue1 := _vwap + stdevAbs * bandMult_1
    lowerBandValue1 := _vwap - stdevAbs * bandMult_1

ma5 = ta.sma(ma_source, 5)
ma20 = ta.sma(ma_source, 20)

// ===== SMA（期間可変）とスムージングMA / ボリンジャーバンド =====
sma_out = ta.sma(sma_src, sma_len)
sma_is_bb = sma_ma_type == "SMA + Bollinger Bands"
sma_enable_ma = sma_ma_type != "None"

smaSmooth(source, length, maType) =>
    switch maType
        "SMA" => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

sma_smoothing = sma_enable_ma ? smaSmooth(sma_out, sma_ma_len, sma_ma_type) : na
sma_stdev = sma_is_bb ? ta.stdev(sma_out, sma_ma_len) * sma_bb_mult : na

if show_prev_htf
    prevOpenHTF  := request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_off)
    prevCloseHTF := request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
    prevHighHTF  := request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_off)
    prevLowHTF   := request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_off)

// ===== 前日大引けVWAPライン =====
if show_prev_vwap_close
    if timeframe.change("D")
        prevDayVWAPClose := vwapValue[1]

        if not na(prevDayVWAPClose_line)
            line.set_x2(prevDayVWAPClose_line, bar_index)
            line.set_extend(prevDayVWAPClose_line, extend.none)

        if not na(prevDayVWAPClose)
            prevDayVWAPClose_line := line.new(
                 bar_index, prevDayVWAPClose,
                 bar_index, prevDayVWAPClose,
                 extend=extend.right,
                 width=prev_vwap_close_width,
                 color=prev_vwap_close_color
             )

    if not na(prevDayVWAPClose_line) and line.get_x2(prevDayVWAPClose_line) != bar_index
        line.set_x2(prevDayVWAPClose_line, bar_index)
else
    // チェックを外したときに削除
    if not na(prevDayVWAPClose_line)
        line.delete(prevDayVWAPClose_line)
        prevDayVWAPClose_line := na

is_new_day = use_custom_start ? session_date != nz(session_date[1]) : ta.change(time("1D")) != 0
is_target_date_bar = session_date == target_date

if is_target_date_bar
    if is_new_day
        daily_open := open
        daily_high := high
        daily_low := low
        daily_close := close
        sum_price_volume := hlc3 * volume
        sum_volume := volume
    else
        daily_high := math.max(daily_high, high)
        daily_low := math.min(daily_low, low)
        daily_close := close
        sum_price_volume += hlc3 * volume
        sum_volume += volume
    daily_vwap_value := sum_price_volume / sum_volume

plot(vwapValue, title="VWAP", color=vwap_line_color, linewidth=vwap_line_width, offset=offset_vwap)

upperBand_1 = plot(upperBandValue1, title="Upper Band #1", color=band1_color, linewidth=band1_width, offset=offset_vwap, display=showBand_1 ? display.all : display.none)
lowerBand_1 = plot(lowerBandValue1, title="Lower Band #1", color=band1_color, linewidth=band1_width, offset=offset_vwap, display=showBand_1 ? display.all : display.none)
fill(upperBand_1, lowerBand_1, title="Bands Fill #1", color=band1_fill_color, display=showBand_1 ? display.all : display.none)

plot(show_ma5 ? ma5 : na, title="5本移動平均", color=ma5_color, linewidth=ma5_width)
plot(show_ma20 ? ma20 : na, title="20本移動平均", color=ma20_color, linewidth=ma20_width)
plot(show_sma ? sma_out : na, title="SMA", color=sma_color, linewidth=sma_width, offset=sma_offset)
plot(show_sma and sma_enable_ma ? sma_smoothing : na, title="SMAスムージングMA", color=sma_color_ma)
sma_bb_upper = plot(show_sma and sma_is_bb ? sma_smoothing + sma_stdev : na, title="SMA BB上限", color=sma_color_bb)
sma_bb_lower = plot(show_sma and sma_is_bb ? sma_smoothing - sma_stdev : na, title="SMA BB下限", color=sma_color_bb)
fill(sma_bb_upper, sma_bb_lower, color=show_sma and sma_is_bb ? color.new(sma_color_bb, 90) : na, title="SMA BB背景")

// ラインは show_daily_ohlc でのみ制御
plot(is_target_date_bar and show_daily_ohlc and not na(daily_open) ? daily_open : na, title="始値", color=open_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_high) ? daily_high : na, title="高値", color=high_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_low) ? daily_low : na, title="安値", color=low_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_close) ? daily_close : na, title="終値", color=close_color, linewidth=line_width)

// ===== 前日四本値の処理 =====
if show_prev_htf
    if timeframe.change("D")
        // 古い線を閉じる
        if not na(prevOpenHTF_line)
            line.set_x2(prevOpenHTF_line, bar_index)
            line.set_extend(prevOpenHTF_line, extend.none)
        if not na(prevCloseHTF_line)
            line.set_x2(prevCloseHTF_line, bar_index)
            line.set_extend(prevCloseHTF_line, extend.none)
        if not na(prevHighHTF_line)
            line.set_x2(prevHighHTF_line, bar_index)
            line.set_extend(prevHighHTF_line, extend.none)
        if not na(prevLowHTF_line)
            line.set_x2(prevLowHTF_line, bar_index)
            line.set_extend(prevLowHTF_line, extend.none)

        // 新しい線を作成
        prevOpenHTF_line  := line.new(bar_index, prevOpenHTF,  bar_index, prevOpenHTF,  extend=extend.right, width=prev_htf_line_width, color=prev_htf_open_color)
        prevCloseHTF_line := line.new(bar_index, prevCloseHTF, bar_index, prevCloseHTF, extend=extend.right, width=prev_htf_line_width, color=prev_htf_close_color)
        prevHighHTF_line  := line.new(bar_index, prevHighHTF,  bar_index, prevHighHTF,  extend=extend.right, width=prev_htf_line_width, color=prev_htf_high_color)
        prevLowHTF_line   := line.new(bar_index, prevLowHTF,   bar_index, prevLowHTF,   extend=extend.right, width=prev_htf_line_width, color=prev_htf_low_color)

        if show_prev_labels
            label.new(bar_index, prevOpenHTF,  "OPEN",  style=label.style_none, textcolor=prev_htf_open_color,  textalign=text.align_right)
            label.new(bar_index, prevCloseHTF, "CLOSE", style=label.style_none, textcolor=prev_htf_close_color, textalign=text.align_right)
            label.new(bar_index, prevHighHTF,  "HIGH",  style=label.style_none, textcolor=prev_htf_high_color,  textalign=text.align_right)
            label.new(bar_index, prevLowHTF,   "LOW",   style=label.style_none, textcolor=prev_htf_low_color,   textalign=text.align_right)

    // 線の右端を現在バーに合わせる
    if not na(prevOpenHTF_line) and line.get_x2(prevOpenHTF_line) != bar_index
        line.set_x2(prevOpenHTF_line,  bar_index)
        line.set_x2(prevCloseHTF_line, bar_index)
        line.set_x2(prevHighHTF_line,  bar_index)
        line.set_x2(prevLowHTF_line,   bar_index)
else
    // チェックを外したときに線を削除
    if not na(prevOpenHTF_line)
        line.delete(prevOpenHTF_line)
        prevOpenHTF_line := na
    if not na(prevCloseHTF_line)
        line.delete(prevCloseHTF_line)
        prevCloseHTF_line := na
    if not na(prevHighHTF_line)
        line.delete(prevHighHTF_line)
        prevHighHTF_line := na
    if not na(prevLowHTF_line)
        line.delete(prevLowHTF_line)
        prevLowHTF_line := na

// ===== 単日四本値のラベル処理（ライン非表示でもラベル単独で表示可能） =====
show_label_condition = barstate.islast and not na(daily_open)

if show_labels and show_label_condition
    label.delete(open_label)
    label.delete(high_label)
    label.delete(low_label)
    label.delete(close_label)
    label.delete(daily_vwap_label)

    label_x = bar_index + label_offset

    if not na(daily_open)
        open_label := label.new(label_x, daily_open, text="始値：" + str.tostring(daily_open, "#.##"), color=color.new(open_color, 80), textcolor=open_color, style=label.style_label_left, size=size.small)
    if not na(daily_high)
        high_label := label.new(label_x, daily_high, text="高値：" + str.tostring(daily_high, "#.##"), color=color.new(high_color, 80), textcolor=high_color, style=label.style_label_left, size=size.small)
    if not na(daily_low)
        low_label := label.new(label_x, daily_low, text="安値：" + str.tostring(daily_low, "#.##"), color=color.new(low_color, 80), textcolor=low_color, style=label.style_label_left, size=size.small)
    if not na(daily_close)
        close_label := label.new(label_x, daily_close, text="終値：" + str.tostring(daily_close, "#.##"), color=color.new(close_color, 80), textcolor=close_color, style=label.style_label_left, size=size.small)
    if not na(daily_vwap_value)
        daily_vwap_label := label.new(label_x, daily_vwap_value, text="VWAP：" + str.tostring(daily_vwap_value, "#.##"), color=color.new(daily_vwap_color, 80), textcolor=daily_vwap_color, style=label.style_label_left, size=size.small)
else
    // チェックを外したときにラベルを消す
    label.delete(open_label)
    label.delete(high_label)
    label.delete(low_label)
    label.delete(close_label)
    label.delete(daily_vwap_label)
    open_label := na
    high_label := na
    low_label := na
    close_label := na
    daily_vwap_label := na

// ===== テーブル処理（ライン非表示でもテーブル単独で表示可能） =====
if show_table and show_label_condition and not timeframe.isdwm
    table_pos = switch table_position
        "右上" => position.top_right
        "左上" => position.top_left
        "右下" => position.bottom_right
        "左下" => position.bottom_left
        => position.top_right

    table.delete(info_table)
    info_table := table.new(table_pos, 2, 7, bgcolor=color.white, border_width=1, border_color=color.gray)

    target_year  = int(target_date / 10000)
    target_month = int((target_date % 10000) / 100)
    target_day   = int(target_date % 100)
    target_date_str = str.tostring(target_year) + "/" + str.tostring(target_month) + "/" + str.tostring(target_day)

    table.cell(info_table, 0, 0, "項目", text_color=color.black, bgcolor=color.new(color.gray, 50), text_size=size.normal)
    table.cell(info_table, 1, 0, "価格", text_color=color.black, bgcolor=color.new(color.gray, 50), text_size=size.normal)
    table.cell(info_table, 0, 1, "対象日", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 1, target_date_str, text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 2, "始値", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 2, str.tostring(daily_open, "#.##"), text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 3, "高値", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 3, str.tostring(daily_high, "#.##"), text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 4, "安値", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 4, str.tostring(daily_low, "#.##"), text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 5, "終値", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 5, str.tostring(daily_close, "#.##"), text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 6, "VWAP", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 6, str.tostring(daily_vwap_value, "#.##"), text_color=color.black, text_size=size.normal)
else
    // チェックを外したときにテーブルを消す
    table.delete(info_table)
    info_table := na

// =============================================================================
// Order Block Detector [LuxAlgo]
// This work is licensed under CC BY-NC-SA 4.0 (https://creativecommons.org/licenses/by-nc-sa/4.0/)
// © LuxAlgo  ※Pine v5 から v6 へ変換し、本インジケーターに統合
// =============================================================================
OB_GROUP = "オーダーブロック設定 [LuxAlgo]"
obShow = input.bool(true, "オーダーブロックを表示", group=OB_GROUP)
obLength = input.int(5, "Volume Pivot Length", minval=1, group=OB_GROUP)
obBullExt = input.int(3, "強気OB 表示数", minval=1, group=OB_GROUP, inline="obbull")
obBgBull = input.color(color.new(#169400, 80), "", group=OB_GROUP, inline="obbull")
obBullCss = input.color(#169400, "", group=OB_GROUP, inline="obbull")
obBullAvg = input.color(color.new(#9598a1, 37), "", group=OB_GROUP, inline="obbull")
obBearExt = input.int(3, "弱気OB 表示数", minval=1, group=OB_GROUP, inline="obbear")
obBgBear = input.color(color.new(#ff1100, 80), "", group=OB_GROUP, inline="obbear")
obBearCss = input.color(#ff1100, "", group=OB_GROUP, inline="obbear")
obBearAvg = input.color(color.new(#9598a1, 37), "", group=OB_GROUP, inline="obbear")
obLineStyle = input.string("⎯⎯⎯", "平均線のスタイル", options=["⎯⎯⎯", "----", "····"], group=OB_GROUP)
obLineWidth = input.int(1, "平均線の太さ", minval=1, group=OB_GROUP)
obMitigation = input.string("Wick", "ミティゲーション方式", options=["Wick", "Close"], group=OB_GROUP)

ob_get_line_style(style) =>
    switch style
        "----" => line.style_dashed
        "····" => line.style_dotted
        => line.style_solid

// オーダーブロックの座標を取得
ob_get_coordinates(condition, top, btm, obVal) =>
    var arrTop = array.new_float(0)
    var arrBtm = array.new_float(0)
    var arrAvg = array.new_float(0)
    var arrLeft = array.new_int(0)

    float obFound = na

    if condition
        array.unshift(arrTop, top)
        array.unshift(arrBtm, btm)
        array.unshift(arrAvg, math.avg(top, btm))
        array.unshift(arrLeft, time[obLength])
        obFound := obVal

    [arrTop, arrBtm, arrAvg, arrLeft, obFound]

// ミティゲーション済みのオーダーブロックを削除
ob_remove_mitigated(arrTop, arrBtm, arrLeft, arrAvg, target, bull) =>
    mitigated = false
    targetArr = bull ? arrBtm : arrTop
    i = array.size(targetArr) - 1
    while i >= 0
        element = array.get(targetArr, i)
        if bull ? target < element : target > element
            mitigated := true
            array.remove(arrTop, i)
            array.remove(arrBtm, i)
            array.remove(arrAvg, i)
            array.remove(arrLeft, i)
        i := i - 1
    mitigated

// 最終バーでボックスと平均線を描画（毎回作り直す）
ob_set_order_blocks(arrTop, arrBtm, arrLeft, arrAvg, extLast, bgCss, borderCss, lvlCss) =>
    var array<box> obBoxes = array.new<box>()
    var array<line> obLvls = array.new<line>()
    if barstate.islast
        for b in obBoxes
            box.delete(b)
        for l in obLvls
            line.delete(l)
        array.clear(obBoxes)
        array.clear(obLvls)
        if obShow and array.size(arrTop) > 0
            for i = 0 to math.min(extLast - 1, array.size(arrTop) - 1)
                leftT = array.get(arrLeft, i)
                avgP = array.get(arrAvg, i)
                array.push(obBoxes, box.new(leftT, array.get(arrTop, i), leftT, array.get(arrBtm, i), xloc=xloc.bar_time, extend=extend.right, bgcolor=bgCss, border_color=color.new(borderCss, 70)))
                array.push(obLvls, line.new(leftT, avgP, leftT + 1, avgP, xloc=xloc.bar_time, extend=extend.right, color=lvlCss, style=ob_get_line_style(obLineStyle), width=obLineWidth))
    0

var int obOs = 0
var float obTargetBull = 0.0
var float obTargetBear = 0.0

obUpper = ta.highest(obLength)
obLower = ta.lowest(obLength)
obCloseLow = ta.lowest(close, obLength)
obCloseHigh = ta.highest(close, obLength)

obTargetBull := obMitigation == "Close" ? obCloseLow : obLower
obTargetBear := obMitigation == "Close" ? obCloseHigh : obUpper

obOs := high[obLength] > obUpper ? 0 : low[obLength] < obLower ? 1 : obOs[1]

obPhv = ta.pivothigh(volume, obLength, obLength)
obPivot = not na(obPhv)

[obBullTop, obBullBtm, obBullAvgArr, obBullLeft, obBullFound] = ob_get_coordinates(obPivot and obOs == 1, hl2[obLength], low[obLength], low[obLength])
[obBearTop, obBearBtm, obBearAvgArr, obBearLeft, obBearFound] = ob_get_coordinates(obPivot and obOs == 0, high[obLength], hl2[obLength], high[obLength])

obMitigatedBull = ob_remove_mitigated(obBullTop, obBullBtm, obBullLeft, obBullAvgArr, obTargetBull, true)
obMitigatedBear = ob_remove_mitigated(obBearTop, obBearBtm, obBearLeft, obBearAvgArr, obTargetBear, false)

ob_set_order_blocks(obBullTop, obBullBtm, obBullLeft, obBullAvgArr, obBullExt, obBgBull, obBullCss, obBullAvg)
ob_set_order_blocks(obBearTop, obBearBtm, obBearLeft, obBearAvgArr, obBearExt, obBgBear, obBearCss, obBearAvg)

alertcondition(not na(obBullFound), "Bullish OB Formed", "Bullish order block detected")
alertcondition(not na(obBearFound), "Bearish OB Formed", "Bearish order block detected")
alertcondition(obMitigatedBull, "Bullish OB Mitigated", "Bullish order block mitigated")
alertcondition(obMitigatedBear, "Bearish OB Mitigated", "Bearish order block mitigated")
