//@version=6
indicator("統合版：VWAP & Zig Zag & 単日四本値 + 節サイン", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

import DevLucem/ZigLib/1 as ZigZag

VWAP_GROUP = "期間別VWAP設定"
BANDS_GROUP = "バンド設定"
MA_GROUP = "移動平均線設定"
DAILY_GROUP = "単日四本値設定"
COLOR_GROUP = "色設定"
LABEL_GROUP = "ラベル・テーブル設定"
PREV_HTF_GROUP = "前日の四本値設定"
ZIGZAG_GROUP = "Zig Zag設定"
ZZ_LINE_GROUP = "Zig Zag ライン設定"
ZZ_LABEL_GROUP = "Zig Zag ラベル設定"
ZZ_COLOR_GROUP = "Zig Zag 色設定"
SMA_GROUP = "SMA設定（期間可変）"
SMA_SMOOTH_GROUP = "SMAスムージング設定"

hideonDWM = input(true, title="日足以上ではVWAPを非表示", group=VWAP_GROUP, display=display.data_window)
offset_vwap = input.int(0, title="オフセット", group=VWAP_GROUP, minval=0, display=display.data_window)
vwap_line_color = input.color(color.aqua, "VWAPラインの色", group=VWAP_GROUP)
vwap_line_width = input.int(2, "VWAPラインの太さ", group=VWAP_GROUP, minval=1, maxval=5)

showBand_1 = input(false, title="", group=BANDS_GROUP, inline="band_1", display=display.data_window)
bandMult_1 = input.float(1.0, title="バンド乗数 #1", group=BANDS_GROUP, inline="band_1", step=0.5, minval=0, display=display.data_window, active=showBand_1)
band1_color = input.color(color.green, "バンド #1の色", group=BANDS_GROUP, inline="band_1_color")
band1_width = input.int(1, "バンド #1の太さ", group=BANDS_GROUP, inline="band_1_width", minval=1, maxval=5)
band1_fill_color = input.color(color.new(color.green, 95), "バンド #1の塗りつぶし", group=BANDS_GROUP, inline="band_1_color")

show_ma5 = input.bool(false, "5本移動平均線を表示", group=MA_GROUP)
ma5_color = input.color(color.red, "5本MAの色", group=MA_GROUP)
ma5_width = input.int(2, "5本MAの太さ", group=MA_GROUP, minval=1, maxval=5)
show_ma20 = input.bool(false, "20本移動平均線を表示", group=MA_GROUP)
ma20_color = input.color(color.yellow, "20本MAの色", group=MA_GROUP)
ma20_width = input.int(2, "20本MAの太さ", group=MA_GROUP, minval=1, maxval=5)
show_ma200 = input.bool(true, "200日移動平均線を表示", group=MA_GROUP)
ma200_color = input.color(color.purple, "200日MAの色", group=MA_GROUP)
ma200_width = input.int(2, "200日MAの太さ", group=MA_GROUP, minval=1, maxval=5)
ma_source = input.source(close, "MA計算ソース", group=MA_GROUP)
show_sma = input.bool(true, "SMAを表示", group=SMA_GROUP)
sma_len = input.int(6, "SMA期間", minval=1, group=SMA_GROUP)
sma_src = input.source(close, "SMAソース", group=SMA_GROUP)
sma_offset = input.int(0, "SMAオフセット", minval=-500, maxval=500, group=SMA_GROUP, display=display.none)
sma_color_up   = input.color(color.blue, "SMAの色（上向き）", group=SMA_GROUP)
sma_color_down = input.color(color.red,  "SMAの色（下向き）", group=SMA_GROUP)
sma_width = input.int(3, "SMAの太", minval=1, maxval=5, group=SMA_GROUP)
sma_style = input.string("点線", "SMAの形状", options=["実線", "破線", "点線"], group=SMA_GROUP)
sma_ma_type = input.string("None", "スムージング種類", options=["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"], group=SMA_SMOOTH_GROUP, display=display.none)
sma_ma_len = input.int(14, "スムージング期間", minval=1, group=SMA_SMOOTH_GROUP, display=display.none, active=sma_ma_type != "None")
sma_bb_mult = input.float(2.0, "BB標準偏差", minval=0.001, maxval=50, step=0.5, group=SMA_SMOOTH_GROUP, tooltip="「SMA + Bollinger Bands」選択時のみ有効。SMAとバンドの距離を決めます。", display=display.none, active=sma_ma_type == "SMA + Bollinger Bands")
sma_color_ma = input.color(color.yellow, "スムージングMAの色", group=SMA_SMOOTH_GROUP)
sma_ma_style = input.string("実線", "スムージングMAの形状", options=["実線", "破線", "点線"], group=SMA_SMOOTH_GROUP)
sma_ma_width = input.int(1, "スムージングMAの太さ", minval=1, maxval=5, group=SMA_SMOOTH_GROUP)
sma_color_bb = input.color(color.green, "BBの色", group=SMA_SMOOTH_GROUP)

target_date_raw = input.int(0, "表示対象日 (YYYYMMDD、0=当日)", group=DAILY_GROUP, minval=0, maxval=20991231)
use_custom_start = input.bool(true, "開始時刻を固定する", group=DAILY_GROUP)
start_hour = input.int(6, "開始時刻（時）", minval=0, maxval=23, group=DAILY_GROUP)
start_minute = input.int(0, "開始時刻（分）", minval=0, maxval=59, group=DAILY_GROUP)
start_tz = input.string("Asia/Tokyo", "開始時刻のタイムゾーン", options=["Asia/Tokyo", "America/New_York", "Europe/London", "UTC"], group=DAILY_GROUP)

// 開始時刻を基準にした「セッション日付」（開始時刻から24時間を1日として扱う）
start_offset_ms = (start_hour * 60 + start_minute) * 60 * 1000
shifted_time = time - start_offset_ms
session_date = use_custom_start ? year(shifted_time, start_tz) * 10000 + month(shifted_time, start_tz) * 100 + dayofmonth(shifted_time, start_tz) : year * 10000 + month * 100 + dayofmonth
today_date = session_date
target_date = target_date_raw == 0 ? today_date : target_date_raw

show_daily_ohlc_input = input.bool(true, "四本値を表示", group=DAILY_GROUP)
show_daily_ohlc = timeframe.isdwm ? false : show_daily_ohlc_input

open_color = input.color(color.white, "始値の色", group=COLOR_GROUP)
high_color = input.color(color.green, "高値の色", group=COLOR_GROUP)
low_color = input.color(color.red, "安値の色", group=COLOR_GROUP)
close_color = input.color(color.gray, "終値の色", group=COLOR_GROUP)
daily_vwap_color = input.color(color.aqua, "単日VWAPの色", group=COLOR_GROUP)
line_width = input.int(2, "ライン幅", minval=1, maxval=5, group=COLOR_GROUP)

show_labels = input.bool(true, "価格ラベを表示", group=LABEL_GROUP)
label_offset = input.int(10, "ラベルオフセット", minval=0, maxval=50, group=LABEL_GROUP)
show_table = input.bool(true, "情報テーブルを表示", group=LABEL_GROUP)
table_position = input.string("左下", "テーブル位置", options=["右上", "左上", "右下", "左下"], group=LABEL_GROUP)
show_table_date = input.bool(false, "テーブル: 対象日", group=LABEL_GROUP, inline="tbl")
show_table_open = input.bool(false, "テーブル: 始値", group=LABEL_GROUP, inline="tbl")
show_table_high = input.bool(false, "テーブル: 高値", group=LABEL_GROUP, inline="tbl")
show_table_low  = input.bool(false, "テーブル: 安値", group=LABEL_GROUP, inline="tbl")
show_table_close = input.bool(false, "テーブル: 終値", group=LABEL_GROUP, inline="tbl")
show_table_vwap  = input.bool(true, "テーブル: VWAP", group=LABEL_GROUP, inline="tbl")
show_table_sma_dir = input.bool(true, "テーブル: SMA方向", group=LABEL_GROUP, inline="tbl")

show_prev_htf_input = input.bool(true, "前日の四本値を表示", group=PREV_HTF_GROUP)
show_prev_htf = timeframe.isdwm ? false : show_prev_htf_input
prev_htf_open_color = input.color(color.white, "前日始値の色", group=PREV_HTF_GROUP)
prev_htf_close_color = input.color(color.gray, "前日終値の色", group=PREV_HTF_GROUP)
prev_htf_high_color = input.color(color.green, "前日高値の色", group=PREV_HTF_GROUP)
prev_htf_low_color = input.color(color.red, "前日安値の色", group=PREV_HTF_GROUP)
prev_htf_line_width = input.int(1, "前日ラインの太さ", minval=1, maxval=5, group=PREV_HTF_GROUP)
show_prev_labels = input.bool(true, "前日四本値のラベルを表示", group=PREV_HTF_GROUP)

// ===== 追加：前日大引けVWAPライン設定 =====
show_prev_vwap_close_input = input.bool(true, "前日大引けVWAPを表示", group=PREV_HTF_GROUP)
show_prev_vwap_close = timeframe.isdwm ? false : show_prev_vwap_close_input
prev_vwap_close_color = input.color(color.aqua, "前日VWAPの色", group=PREV_HTF_GROUP)
prev_vwap_close_width = input.int(2, "前日VWAPの太さ", minval=1, maxval=5, group=PREV_HTF_GROUP)

show_zigzag = input.bool(true, "Zig Zagを表示", group=ZIGZAG_GROUP)
zzDepth = input.int(12, "Depth", minval=1, step=1, group=ZIGZAG_GROUP)
zzDeviation = input.int(5, "Deviation", minval=1, step=1, group=ZIGZAG_GROUP)
zzBackstep = input.int(2, "Backstep", minval=2, step=1, group=ZIGZAG_GROUP)
zzRepaint = input.bool(true, "リペイント（レベルを更新し続ける）", group=ZIGZAG_GROUP)
zzExtend = input.bool(false, "Zig Zagを右へ延長", group=ZZ_LINE_GROUP)
zzLineThick = input.int(2, "ライン太さ", minval=1, maxval=4, group=ZZ_LINE_GROUP)
zzLineTransp = input.int(0, "ライン透明度", minval=0, maxval=100, group=ZZ_LINE_GROUP)
zzShowLabels = input.bool(true, "HH/LH/HL/LLラベルを表示", group=ZZ_LABEL_GROUP)
zzLabelTransp = input.int(0, "ラベル透明度", minval=0, maxval=100, group=ZZ_LABEL_GROUP)
zzLabelTextColor = input.color(color.white, "ラベル文字色", group=ZZ_LABEL_GROUP)
zzLabelSize = switch input.int(3, "ラベルサイズ", minval=1, maxval=5, group=ZZ_LABEL_GROUP)
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge
zzUpColor = input.color(color.lime, "上昇の色", group=ZZ_COLOR_GROUP)
zzDnColor = input.color(color.red, "下降の色", group=ZZ_COLOR_GROUP)
zzShowBg = input.bool(false, "方向の背景色を表示", group=ZZ_COLOR_GROUP)
zzBgTransp = input.int(80, "背景透明度", minval=0, maxval=100, group=ZZ_COLOR_GROUP)

// ══════════════════════════════════════════════════════════════
// 【追加】相場の節目自動表示 Ver7（サイン付き）— 入力
// ══════════════════════════════════════════════════════════════
group_pd = "【節目】前日"
show_pdh = input.bool(true,  "前日高値", group=group_pd)
show_pdl = input.bool(true,  "前日安値", group=group_pd)
show_pdc = input.bool(true,  "前日終値", group=group_pd)
show_pdo = input.bool(true, "前日始値", group=group_pd)

group_w = "【節目】週"
show_pwh = input.bool(true,  "前週高値", group=group_w)
show_pwl = input.bool(true,  "前週安値", group=group_w)
show_cwo = input.bool(true,  "今週始値", group=group_w)

group_piv = "【節目】ピボット"
show_pivot = input.bool(true, "ピボット表示", group=group_piv)
show_r2 = input.bool(true, "R2", group=group_piv)
show_r1 = input.bool(true, "R1", group=group_piv)
show_pp = input.bool(true, "PP", group=group_piv)
show_s1 = input.bool(true, "S1", group=group_piv)
show_s2 = input.bool(true, "S2", group=group_piv)

group_ses = "【節目】セッションボックス"
show_tokyo_box  = input.bool(false, "東京時間ボックス", group=group_ses)
show_london_box = input.bool(false, "ロンドン時間ボックス", group=group_ses)
show_ny_box     = input.bool(false, "NY時間ボックス", group=group_ses)

tokyo_sess  = input.session("0900-1800", "東京時間", group=group_ses)
london_sess = input.session("1600-0100", "ロンドン時間", group=group_ses)
ny_sess     = input.session("2100-0600", "NY時間", group=group_ses)

tokyo_bg  = input.color(color.new(#1a237e, 75), "東京背景色", group=group_ses)
london_bg = input.color(color.new(#e65100, 75), "ロンドン背景色", group=group_ses)
ny_bg     = input.color(color.new(#004d40, 75), "NY背景色", group=group_ses)

group_round = "【節目】キリ番（心理的節目）"
show_round = input.bool(false, "キリ番を表示", group=group_round)
round_step = input.float(50.0, "キリの間隔", minval=10, step=10, group=group_round)
round_count = input.int(6, "上下に表示する本数", minval=1, maxval=15, group=group_round)
round_color = input.color(color.new(#9e9e9e, 30), "キリ番の色", group=group_round)

mkl_line_width = input.int(1, "節目ライン太さ", minval=1, maxval=3, group=group_round)

group_sig = "【節目】サイン"
use_sig = input.bool(false, "サインを表示", group=group_sig)
use_wick = input.bool(false, "ヒゲ反転", group=group_sig)
use_dbl = input.bool(false, "ダブルトップ/ボトム", group=group_sig)
use_fail = input.bool(false, "抜け失敗", group=group_sig)
atr_len = input.int(14, "ATR期間", minval=1, group=group_sig)
tol_mult = input.float(0.15, "節目への接近許容（ATR倍）", minval=0.0, step=0.05, group=group_sig)
pierce_mult = input.float(0.30, "節目の突き抜け許容（ATR倍）", minval=0.0, step=0.05, group=group_sig)
wick_ratio = input.float(2.0, "ヒゲ/実体の比率", minval=0.5, step=0.5, group=group_sig)
wick_min = input.float(0.5, "ヒゲの最小長（ATR倍）", minval=0.0, step=0.1, group=group_sig)
pivot_len = input.int(3, "ピボト左右本数", minval=1, maxval=10, group=group_sig)
dbl_lookback = input.int(20, "ダブルの最大間隔（本）", minval=3, maxval=200, group=group_sig)
dbl_depth = input.float(0.5, "ダブルの谷の深さ（ATR倍）", minval=0.0, step=0.1, group=group_sig)
fail_lookback = input.int(30, "抜け失敗の観測本数", minval=5, maxval=200, group=group_sig)
fail_touches = input.int(2, "抜け失敗の最小タッチ回数", minval=2, maxval=10, group=group_sig)
fail_away = input.float(1.0, "離脱判定（ATR倍）", minval=0.1, step=0.1, group=group_sig)
cooldown = input.int(10, "同じ節目のクールダウン（本）", minval=0, maxval=200, group=group_sig)


var float daily_open = na
var float daily_high = na
var float daily_low = na
var float daily_close = na
var float sum_price_volume = 0.0
var float sum_volume = 0.0
var float daily_vwap_value = na

var label open_label = na
var label high_label = na
var label low_label = na
var label close_label = na
var label daily_vwap_label = na

var float prevOpenHTF = na
var float prevCloseHTF = na
var float prevHighHTF = na
var float prevLowHTF = na
var line prevOpenHTF_line = na
var line prevCloseHTF_line = na
var line prevHighHTF_line = na
var line prevLowHTF_line = na

// ===== 追加：前日大引けVWAPライン用 =====
var float prevDayVWAPClose = na
var line  prevDayVWAPClose_line = na

var table info_table = na

// ===== Zig Zag++ [LD]（MT4 ZigZag準拠） =====
[zzDirection, zz1, zz2] = ZigZag.zigzag(low, high, zzDepth, zzDeviation, zzBackstep)
float zzP1Prev = na(zz1[1]) ? na : (zz1[1]).price
float zzP2 = na(zz2) ? na : zz2.price
float zzP2Prev = na(zz2[1]) ? na : (zz2[1]).price
string zzNowPoint = ""
var float zzLastPoint = zzP1Prev
if bool(ta.change(zzDirection))
    zzLastPoint := zzP1Prev

line zzLine = na
label zzPoint = na

if show_zigzag and not na(zz1) and not na(zz2)
    if zzRepaint
        zzLine := line.new(zz1, zz2, xloc.bar_time, zzExtend ? extend.right : extend.none, color.new(zzDirection > 0 ? zzUpColor : zzDnColor, zzLineTransp), width=zzLineThick)
        zzNowPoint := zzDirection < 0 ? (zzP2 < zzLastPoint ? "LL" : "HL") : (zzP2 > zzLastPoint ? "HH" : "LH")
        if zzShowLabels
            zzPoint := label.new(zz2, zzNowPoint, xloc.bar_time, yloc.price, color.new(zzDirection < 0 ? zzUpColor : zzDnColor, zzLabelTransp), zzDirection > 0 ? label.style_label_down : label.style_label_up, zzLabelTextColor, zzLabelSize)
        if zzDirection == zzDirection[1]
            line.delete(zzLine[1])
            label.delete(zzPoint[1])
        else
            line.set_extend(zzLine[1], extend.none)
    else
        if zzDirection != zzDirection[1]
            zzLine := line.new(zz1[1], zz2[1], xloc.bar_time, extend.none, color.new(zzDirection > 0 ? zzUpColor : zzDnColor, zzLineTransp), width=zzLineThick)
            zzNowPoint := zzDirection[1] < 0 ? (zzP2Prev < zzLastPoint[1] ? "LL" : "HL") : (zzP2Prev > zzLastPoint[1] ? "HH" : "LH")
            if zzShowLabels
                zzPoint := label.new(zz2[1], zzNowPoint, xloc.bar_time, yloc.price, color.new(zzDirection[1] < 0 ? zzUpColor : zzDnColor, zzLabelTransp), zzDirection[1] > 0 ? label.style_label_down : label.style_label_up, zzLabelTextColor, zzLabelSize)

bgcolor(show_zigzag and zzShowBg ? (zzDirection < 0 ? color.new(zzDnColor, zzBgTransp) : color.new(zzUpColor, zzBgTransp)) : na, title="Direction Background")
plotarrow(zzDirection, "direction", display=display.status_line)

alertcondition(zzNowPoint == "HH" and zzP2 != zzP2Prev, "New Higher High", "Zigzag on {{ticker}} higher high detected at {{time}}")
alertcondition(zzNowPoint == "LH" and zzP2 != zzP2Prev, "New Lower High", "Zigzag on {{ticker}} lower high detected at {{time}}")
alertcondition(zzNowPoint == "HL" and zzP2 != zzP2Prev, "New Higher Low", "Zigzag on {{ticker}} higher low detected at {{time}}")
alertcondition(zzNowPoint == "LL" and zzP2 != zzP2Prev, "New Lower Low", "Zigzag on {{ticker}} lower low detected at {{time}}")
alertcondition(zzDirection != zzDirection[1], "Direction Changed", "Zigzag on {{ticker}} direction changed at {{time}}")
alertcondition(zzDirection != zzDirection[1] and zzDirection > 0, "Bullish Direction", "Zigzag on {{ticker}} bullish direction at {{time}}")
alertcondition(zzDirection != zzDirection[1] and zzDirection < 0, "Bearish Direction", "Zigzag on {{ticker}} bearish direction at {{time}}")

if zzDirection != zzDirection[1]
    alert((zzDirection < 0 ? "Bearish" : "Bullish") + " Direction Final ", alert.freq_once_per_bar_close)

cumVolume = ta.cum(volume)

isNewPeriod = timeframe.change("D")
src_vwap = hlc3

float vwapValue = na
float upperBandValue1 = na
float lowerBandValue1 = na

if not (hideonDWM and timeframe.isdwm) and cumVolume > 0
    [_vwap, _stdevUpper, _] = ta.vwap(src_vwap, isNewPeriod, 1)
    vwapValue := _vwap
    stdevAbs = _stdevUpper - _vwap
    upperBandValue1 := _vwap + stdevAbs * bandMult_1
    lowerBandValue1 := _vwap - stdevAbs * bandMult_1

ma5 = ta.sma(ma_source, 5)
ma20 = ta.sma(ma_source, 20)
// 200日移動平均線：日足の200本分を時間足などでも表示できるように日足から取得
ma200 = request.security(syminfo.tickerid, "D", ta.sma(close, 200), gaps=barmerge.gaps_off)

// ===== SMA（期間可変）とスムージングMA / ボリンジャーバンド =====
sma_out = ta.sma(sma_src, sma_len)
sma_is_bb = sma_ma_type == "SMA + Bollinger Bands"
sma_enable_ma = sma_ma_type != "None"

smaSmooth(source, length, maType) =>
    switch maType
        "SMA" => ta.sma(source, length)
        "SMA + Bollinger Bands" => ta.sma(source, length)
        "EMA" => ta.ema(source, length)
        "SMMA (RMA)" => ta.rma(source, length)
        "WMA" => ta.wma(source, length)
        "VWMA" => ta.vwma(source, length)

sma_smoothing = sma_enable_ma ? smaSmooth(sma_out, sma_ma_len, sma_ma_type) : na
sma_stdev = sma_is_bb ? ta.stdev(sma_out, sma_ma_len) * sma_bb_mult : na

// SMA方向判定（1本前との比較）
sma_dir = ta.rising(sma_out, 1) ? 1 : ta.falling(sma_out, 1) ? -1 : 0
sma_dir_color = sma_dir > 0 ? sma_color_up : sma_dir < 0 ? sma_color_down : color.gray
sma_dir_text  = sma_dir > 0 ? "上向き" : sma_dir < 0 ? "下向き" : "横ばい"

// SMA線形状変換
sma_linestyle(style) =>
    switch style
        "破線" => plot.linestyle_dashed
        "点線" => plot.linestyle_dotted
        => plot.linestyle_solid

// ══════════════════════════════════════════════════════════════
// 【追加】相場の節目自動表示 — データ取得・計算
// ══════════════════════════════════════════════════════════════
[mkl_pdh, mkl_pdl, mkl_pdc, mkl_pdo] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_on)
[mkl_pwh, mkl_pwl, mkl_pwc] = request.security(syminfo.tickerid, "W", [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

// 今週始値: チャート自身の足から「今週最初の足の始値」を取得
wk_no = weekofyear(time, "Asia/Tokyo")
wk_chg = ta.change(wk_no)
var float mkl_cwo = na
if barstate.isfirst or wk_chg != 0
    mkl_cwo := open

// ピボット
mkl_pp = (mkl_pdh + mkl_pdl + mkl_pdc) / 3.0
mkl_r1 = 2.0 * mkl_pp - mkl_pdl
mkl_s1 = 2.0 * mkl_pp - mkl_pdh
mkl_r2 = mkl_pp + (mkl_pdh - mkl_pdl)
mkl_s2 = mkl_pp - (mkl_pdh - mkl_pdl)

// ══════════════════════════════════════════════════════════════
// セッション高安（タイムゾーンをAsia/Tokyoに固定）
// ══════════════════════════════════════════════════════════════
var box tokyoBox  = na
var box londonBox = na
var box nyBox     = na

var float tokyoH_cur = na
var float tokyoL_cur = na
var float londonH_cur = na
var float londonL_cur = na
var float nyH_cur = na
var float nyL_cur = na

var float tokyoH = na
var float tokyoL = na
var float londonH = na
var float londonL = na
var float nyH = na
var float nyL = na

is_tokyo  = not na(time(timeframe.period, tokyo_sess, "Asia/Tokyo"))
is_london = not na(time(timeframe.period, london_sess, "Asia/Tokyo"))
is_ny     = not na(time(timeframe.period, ny_sess, "Asia/Tokyo"))

// 東京
if is_tokyo and not is_tokyo[1]
    tokyoH_cur := high
    tokyoL_cur := low
    if show_tokyo_box
        if not na(tokyoBox)
            box.delete(tokyoBox)
        tokyoBox := box.new(bar_index, high, bar_index, low, bgcolor=tokyo_bg, border_color=color.new(tokyo_bg, 40), border_width=1)
else if is_tokyo
    tokyoH_cur := math.max(nz(tokyoH_cur), high)
    tokyoL_cur := math.min(nz(tokyoL_cur), low)
    if not na(tokyoBox)
        box.set_top(tokyoBox, tokyoH_cur)
        box.set_bottom(tokyoBox, tokyoL_cur)
        box.set_right(tokyoBox, bar_index)
else if is_tokyo[1] and not is_tokyo
    tokyoH := tokyoH_cur
    tokyoL := tokyoL_cur

// ロンドン
if is_london and not is_london[1]
    londonH_cur := high
    londonL_cur := low
    if show_london_box
        if not na(londonBox)
            box.delete(londonBox)
        londonBox := box.new(bar_index, high, bar_index, low, bgcolor=london_bg, border_color=color.new(london_bg, 40), border_width=1)
else if is_london
    londonH_cur := math.max(nz(londonH_cur), high)
    londonL_cur := math.min(nz(londonL_cur), low)
    if not na(londonBox)
        box.set_top(londonBox, londonH_cur)
        box.set_bottom(londonBox, londonL_cur)
        box.set_right(londonBox, bar_index)
else if is_london[1] and not is_london
    londonH := londonH_cur
    londonL := londonL_cur

// NY
if is_ny and not is_ny[1]
    nyH_cur := high
    nyL_cur := low
    if show_ny_box
        if not na(nyBox)
            box.delete(nyBox)
        nyBox := box.new(bar_index, high, bar_index, low, bgcolor=ny_bg, border_color=color.new(ny_bg, 40), border_width=1)
else if is_ny
    nyH_cur := math.max(nz(nyH_cur), high)
    nyL_cur := math.min(nz(nyL_cur), low)
    if not na(nyBox)
        box.set_top(nyBox, nyH_cur)
        box.set_bottom(nyBox, nyL_cur)
        box.set_right(nyBox, bar_index)
else if is_ny[1] and not is_ny
    nyH := nyH_cur
    nyL := nyL_cur


if show_prev_htf
    prevOpenHTF  := request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_off)
    prevCloseHTF := request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_off)
    prevHighHTF  := request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_off)
    prevLowHTF   := request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_off)

// ===== 前日大引けVWAPライン =====
if show_prev_vwap_close
    if timeframe.change("D")
        prevDayVWAPClose := vwapValue[1]

        if not na(prevDayVWAPClose_line)
            line.set_x2(prevDayVWAPClose_line, bar_index)
            line.set_extend(prevDayVWAPClose_line, extend.none)

        if not na(prevDayVWAPClose)
            prevDayVWAPClose_line := line.new(
                 bar_index, prevDayVWAPClose,
                 bar_index, prevDayVWAPClose,
                 extend=extend.right,
                 width=prev_vwap_close_width,
                 color=prev_vwap_close_color
             )

    if not na(prevDayVWAPClose_line) and line.get_x2(prevDayVWAPClose_line) != bar_index
        line.set_x2(prevDayVWAPClose_line, bar_index)
else
    // チェックを外したときに削除
    if not na(prevDayVWAPClose_line)
        line.delete(prevDayVWAPClose_line)
        prevDayVWAPClose_line := na

is_new_day = use_custom_start ? session_date != nz(session_date[1]) : ta.change(time("1D")) != 0
is_target_date_bar = session_date == target_date

if is_target_date_bar
    if is_new_day
        daily_open := open
        daily_high := high
        daily_low := low
        daily_close := close
        sum_price_volume := hlc3 * volume
        sum_volume := volume
    else
        daily_high := math.max(daily_high, high)
        daily_low := math.min(daily_low, low)
        daily_close := close
        sum_price_volume += hlc3 * volume
        sum_volume += volume
    daily_vwap_value := sum_price_volume / sum_volume

plot(vwapValue, title="VWAP", color=vwap_line_color, linewidth=vwap_line_width, offset=offset_vwap)

upperBand_1 = plot(upperBandValue1, title="Upper Band #1", color=band1_color, linewidth=band1_width, offset=offset_vwap, display=showBand_1 ? display.all : display.none)
lowerBand_1 = plot(lowerBandValue1, title="Lower Band #1", color=band1_color, linewidth=band1_width, offset=offset_vwap, display=showBand_1 ? display.all : display.none)
fill(upperBand_1, lowerBand_1, title="Bands Fill #1", color=band1_fill_color, display=showBand_1 ? display.all : display.none)

plot(show_ma5 ? ma5 : na, title="5本移動平均", color=ma5_color, linewidth=ma5_width)
plot(show_ma20 ? ma20 : na, title="20本移動平均", color=ma20_color, linewidth=ma20_width)
plot(show_ma200 ? ma200 : na, title="200日移動平均", color=ma200_color, linewidth=ma200_width)
plot(show_sma ? sma_out : na, title="SMA", color=sma_dir_color, linewidth=sma_width, offset=sma_offset, linestyle=sma_linestyle(sma_style))
plot(show_sma and sma_enable_ma ? sma_smoothing : na, title="SMAスムージングMA", color=sma_color_ma, linewidth=sma_ma_width, linestyle=sma_linestyle(sma_ma_style))
sma_bb_upper = plot(show_sma and sma_is_bb ? sma_smoothing + sma_stdev : na, title="SMA BB上限", color=sma_color_bb)
sma_bb_lower = plot(show_sma and sma_is_bb ? sma_smoothing - sma_stdev : na, title="SMA BB下限", color=sma_color_bb)
fill(sma_bb_upper, sma_bb_lower, color=show_sma and sma_is_bb ? color.new(sma_color_bb, 90) : na, title="SMA BB背景")

// ラインは show_daily_ohlc でのみ制御
plot(is_target_date_bar and show_daily_ohlc and not na(daily_open) ? daily_open : na, title="始値", color=open_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_high) ? daily_high : na, title="高値", color=high_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_low) ? daily_low : na, title="安値", color=low_color, linewidth=line_width)
plot(is_target_date_bar and show_daily_ohlc and not na(daily_close) ? daily_close : na, title="終値", color=close_color, linewidth=line_width)

// ===== 前日四本値の処理 =====
if show_prev_htf
    if timeframe.change("D")
        // 古い線を閉じる
        if not na(prevOpenHTF_line)
            line.set_x2(prevOpenHTF_line, bar_index)
            line.set_extend(prevOpenHTF_line, extend.none)
        if not na(prevCloseHTF_line)
            line.set_x2(prevCloseHTF_line, bar_index)
            line.set_extend(prevCloseHTF_line, extend.none)
        if not na(prevHighHTF_line)
            line.set_x2(prevHighHTF_line, bar_index)
            line.set_extend(prevHighHTF_line, extend.none)
        if not na(prevLowHTF_line)
            line.set_x2(prevLowHTF_line, bar_index)
            line.set_extend(prevLowHTF_line, extend.none)

        // 新しい線を作成
        prevOpenHTF_line  := line.new(bar_index, prevOpenHTF,  bar_index, prevOpenHTF,  extend=extend.right, width=prev_htf_line_width, color=prev_htf_open_color)
        prevCloseHTF_line := line.new(bar_index, prevCloseHTF, bar_index, prevCloseHTF, extend=extend.right, width=prev_htf_line_width, color=prev_htf_close_color)
        prevHighHTF_line  := line.new(bar_index, prevHighHTF,  bar_index, prevHighHTF,  extend=extend.right, width=prev_htf_line_width, color=prev_htf_high_color)
        prevLowHTF_line   := line.new(bar_index, prevLowHTF,   bar_index, prevLowHTF,   extend=extend.right, width=prev_htf_line_width, color=prev_htf_low_color)

        if show_prev_labels
            label.new(bar_index, prevOpenHTF,  "OPEN",  style=label.style_none, textcolor=prev_htf_open_color,  textalign=text.align_right)
            label.new(bar_index, prevCloseHTF, "CLOSE", style=label.style_none, textcolor=prev_htf_close_color, textalign=text.align_right)
            label.new(bar_index, prevHighHTF,  "HIGH",  style=label.style_none, textcolor=prev_htf_high_color,  textalign=text.align_right)
            label.new(bar_index, prevLowHTF,   "LOW",   style=label.style_none, textcolor=prev_htf_low_color,   textalign=text.align_right)

    // 線の右端を現在バーに合わせる
    if not na(prevOpenHTF_line) and line.get_x2(prevOpenHTF_line) != bar_index
        line.set_x2(prevOpenHTF_line,  bar_index)
        line.set_x2(prevCloseHTF_line, bar_index)
        line.set_x2(prevHighHTF_line,  bar_index)
        line.set_x2(prevLowHTF_line,   bar_index)
else
    // チェックを外したときに線を削除
    if not na(prevOpenHTF_line)
        line.delete(prevOpenHTF_line)
        prevOpenHTF_line := na
    if not na(prevCloseHTF_line)
        line.delete(prevCloseHTF_line)
        prevCloseHTF_line := na
    if not na(prevHighHTF_line)
        line.delete(prevHighHTF_line)
        prevHighHTF_line := na
    if not na(prevLowHTF_line)
        line.delete(prevLowHTF_line)
        prevLowHTF_line := na

// ===== 単日四本値のラベル処理（ライン非表示でもラベル単独で表示可能） =====
show_label_condition = barstate.islast and not na(daily_open)

if show_labels and show_label_condition
    label.delete(open_label)
    label.delete(high_label)
    label.delete(low_label)
    label.delete(close_label)
    label.delete(daily_vwap_label)

    label_x = bar_index + label_offset

    if not na(daily_open)
        open_label := label.new(label_x, daily_open, text="始値：" + str.tostring(daily_open, "#.##"), color=color.new(open_color, 80), textcolor=open_color, style=label.style_label_left, size=size.small)
    if not na(daily_high)
        high_label := label.new(label_x, daily_high, text="高値：" + str.tostring(daily_high, "#.##"), color=color.new(high_color, 80), textcolor=high_color, style=label.style_label_left, size=size.small)
    if not na(daily_low)
        low_label := label.new(label_x, daily_low, text="安値：" + str.tostring(daily_low, "#.##"), color=color.new(low_color, 80), textcolor=low_color, style=label.style_label_left, size=size.small)
    if not na(daily_close)
        close_label := label.new(label_x, daily_close, text="終値：" + str.tostring(daily_close, "#.##"), color=color.new(close_color, 80), textcolor=close_color, style=label.style_label_left, size=size.small)
    if not na(daily_vwap_value)
        daily_vwap_label := label.new(label_x, daily_vwap_value, text="VWAP：" + str.tostring(daily_vwap_value, "#.##"), color=color.new(daily_vwap_color, 80), textcolor=daily_vwap_color, style=label.style_label_left, size=size.small)
else
    // チェックを外したときにラベルを消す
    label.delete(open_label)
    label.delete(high_label)
    label.delete(low_label)
    label.delete(close_label)
    label.delete(daily_vwap_label)
    open_label := na
    high_label := na
    low_label := na
    close_label := na
    daily_vwap_label := na

// ===== テーブル処理（ライン非表示でもテーブル単独で表示可能） =====
if show_table and show_label_condition and not timeframe.isdwm
    table_pos = switch table_position
        "右上" => position.top_right
        "左上" => position.top_left
        "右下" => position.bottom_right
        "左下" => position.bottom_left
        => position.top_right

    table.delete(info_table)
    // 動的に行数を計算（ヘッダー1行 + 表示項目数）
    int table_rows = 1
    table_rows += show_table_date ? 1 : 0
    table_rows += show_table_open ? 1 : 0
    table_rows += show_table_high ? 1 : 0
    table_rows += show_table_low  ? 1 : 0
    table_rows += show_table_close ? 1 : 0
    table_rows += show_table_vwap  ? 1 : 0
    table_rows += show_table_sma_dir ? 1 : 0
    info_table := table.new(table_pos, 2, table_rows, bgcolor=color.white, border_width=1, border_color=color.gray)

    target_year  = int(target_date / 10000)
    target_month = int((target_date % 10000) / 100)
    target_day   = int(target_date % 100)
    target_date_str = str.tostring(target_year) + "/" + str.tostring(target_month) + "/" + str.tostring(target_day)

    // ヘッダー行
    table.cell(info_table, 0, 0, "項目", text_color=color.black, bgcolor=color.new(color.gray, 50), text_size=size.normal)
    table.cell(info_table, 1, 0, "価格", text_color=color.black, bgcolor=color.new(color.gray, 50), text_size=size.normal)

    // データ行（表示設定に応じて動的に行番号を割り当て）
    int row = 1
    if show_table_date
        table.cell(info_table, 0, row, "対象日", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, target_date_str, text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_open
        table.cell(info_table, 0, row, "始値", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, str.tostring(daily_open, "#.##"), text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_high
        table.cell(info_table, 0, row, "高値", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, str.tostring(daily_high, "#.##"), text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_low
        table.cell(info_table, 0, row, "安値", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, str.tostring(daily_low, "#.##"), text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_close
        table.cell(info_table, 0, row, "終値", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, str.tostring(daily_close, "#.##"), text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_vwap
        table.cell(info_table, 0, row, "VWAP", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, str.tostring(daily_vwap_value, "#.##"), text_color=color.black, text_size=size.normal)
        row += 1
    if show_table_sma_dir
        table.cell(info_table, 0, row, "SMA方向", text_color=color.black, text_size=size.normal)
        table.cell(info_table, 1, row, sma_dir_text, text_color=sma_dir_color, text_size=size.normal)
else
    // チェックを外したときにテーブルを消す
    table.delete(info_table)
    info_table := na

// =============================================================================
// Order Block Detector [LuxAlgo]
// This work is licensed under CC BY-NC-SA 4.0 (https://creativecommons.org/licenses/by-nc-sa/4.0/)
// © LuxAlgo  ※Pine v5 から v6 へ変換し、本インジケーターに統合
// =============================================================================
OB_GROUP = "オーダーブロック設定 [LuxAlgo]"
obShow = input.bool(false, "オーダーブロックを表示", group=OB_GROUP)
obLength = input.int(5, "Volume Pivot Length", minval=1, group=OB_GROUP)
obBullExt = input.int(3, "強気OB 表示数", minval=1, group=OB_GROUP, inline="obbull")
obBgBull = input.color(color.new(#169400, 80), "", group=OB_GROUP, inline="obbull")
obBullCss = input.color(#169400, "", group=OB_GROUP, inline="obbull")
obBullAvg = input.color(color.new(#9598a1, 37), "", group=OB_GROUP, inline="obbull")
obBearExt = input.int(3, "弱気OB 表示数", minval=1, group=OB_GROUP, inline="obbear")
obBgBear = input.color(color.new(#ff1100, 80), "", group=OB_GROUP, inline="obbear")
obBearCss = input.color(#ff1100, "", group=OB_GROUP, inline="obbear")
obBearAvg = input.color(color.new(#9598a1, 37), "", group=OB_GROUP, inline="obbear")
obLineStyle = input.string("⎯⎯⎯", "平均線のスタイル", options=["⎯⎯⎯", "----", "····"], group=OB_GROUP)
obLineWidth = input.int(1, "平均線の太さ", minval=1, group=OB_GROUP)
obMitigation = input.string("Wick", "ミティゲーション方式", options=["Wick", "Close"], group=OB_GROUP)

ob_get_line_style(style) =>
    switch style
        "----" => line.style_dashed
        "····" => line.style_dotted
        => line.style_solid

// オーダーブロックの座標を取得
ob_get_coordinates(condition, top, btm, obVal) =>
    var arrTop = array.new_float(0)
    var arrBtm = array.new_float(0)
    var arrAvg = array.new_float(0)
    var arrLeft = array.new_int(0)

    float obFound = na

    if condition
        array.unshift(arrTop, top)
        array.unshift(arrBtm, btm)
        array.unshift(arrAvg, math.avg(top, btm))
        array.unshift(arrLeft, time[obLength])
        obFound := obVal

    [arrTop, arrBtm, arrAvg, arrLeft, obFound]

// ミティゲーション済みのオーダーブロックを削除
ob_remove_mitigated(arrTop, arrBtm, arrLeft, arrAvg, target, bull) =>
    mitigated = false
    targetArr = bull ? arrBtm : arrTop
    i = array.size(targetArr) - 1
    while i >= 0
        element = array.get(targetArr, i)
        if bull ? target < element : target > element
            mitigated := true
            array.remove(arrTop, i)
            array.remove(arrBtm, i)
            array.remove(arrAvg, i)
            array.remove(arrLeft, i)
        i := i - 1
    mitigated

// 最終バーでボックスと平均線を描画（毎回作り直す）
ob_set_order_blocks(arrTop, arrBtm, arrLeft, arrAvg, extLast, bgCss, borderCss, lvlCss) =>
    var array<box> obBoxes = array.new<box>()
    var array<line> obLvls = array.new<line>()
    if barstate.islast
        for b in obBoxes
            box.delete(b)
        for l in obLvls
            line.delete(l)
        array.clear(obBoxes)
        array.clear(obLvls)
        if obShow and array.size(arrTop) > 0
            for i = 0 to math.min(extLast - 1, array.size(arrTop) - 1)
                leftT = array.get(arrLeft, i)
                avgP = array.get(arrAvg, i)
                array.push(obBoxes, box.new(leftT, array.get(arrTop, i), leftT, array.get(arrBtm, i), xloc=xloc.bar_time, extend=extend.right, bgcolor=bgCss, border_color=color.new(borderCss, 70)))
                array.push(obLvls, line.new(leftT, avgP, leftT + 1, avgP, xloc=xloc.bar_time, extend=extend.right, color=lvlCss, style=ob_get_line_style(obLineStyle), width=obLineWidth))
    0

var int obOs = 0
var float obTargetBull = 0.0
var float obTargetBear = 0.0

obUpper = ta.highest(obLength)
obLower = ta.lowest(obLength)
obCloseLow = ta.lowest(close, obLength)
obCloseHigh = ta.highest(close, obLength)

obTargetBull := obMitigation == "Close" ? obCloseLow : obLower
obTargetBear := obMitigation == "Close" ? obCloseHigh : obUpper

obOs := high[obLength] > obUpper ? 0 : low[obLength] < obLower ? 1 : obOs[1]

obPhv = ta.pivothigh(volume, obLength, obLength)
obPivot = not na(obPhv)

[obBullTop, obBullBtm, obBullAvgArr, obBullLeft, obBullFound] = ob_get_coordinates(obPivot and obOs == 1, hl2[obLength], low[obLength], low[obLength])
[obBearTop, obBearBtm, obBearAvgArr, obBearLeft, obBearFound] = ob_get_coordinates(obPivot and obOs == 0, high[obLength], hl2[obLength], high[obLength])

obMitigatedBull = ob_remove_mitigated(obBullTop, obBullBtm, obBullLeft, obBullAvgArr, obTargetBull, true)
obMitigatedBear = ob_remove_mitigated(obBearTop, obBearBtm, obBearLeft, obBearAvgArr, obTargetBear, false)

ob_set_order_blocks(obBullTop, obBullBtm, obBullLeft, obBullAvgArr, obBullExt, obBgBull, obBullCss, obBullAvg)
ob_set_order_blocks(obBearTop, obBearBtm, obBearLeft, obBearAvgArr, obBearExt, obBgBear, obBearCss, obBearAvg)

alertcondition(not na(obBullFound), "Bullish OB Formed", "Bullish order block detected")
alertcondition(not na(obBearFound), "Bearish OB Formed", "Bearish order block detected")
alertcondition(obMitigatedBull, "Bullish OB Mitigated", "Bullish order block mitigated")
alertcondition(obMitigatedBear, "Bearish OB Mitigated", "Bearish order block mitigated")

// ═════════════════════════════════════════════════════════════
// 【追加】相場の節目自動表示 — サイン判定
// ══════════════════════════════════════════════════════════════
atr = ta.atr(atr_len)
tol = atr * tol_mult
pierce = atr * pierce_mult
away = atr * fail_away

f_push(arr, cond, v) =>
    if cond and not na(v)
        array.push(arr, v)

f_touch_sell(hi, cl, lv, t, p) =>
    hi >= lv - t and hi <= lv + p and cl < lv

f_touch_buy(lo, cl, lv, t, p) =>
    lo <= lv + t and lo >= lv - p and cl > lv

// 節目リスト（表示ONのものだけ）
levels = array.new_float()
f_push(levels, show_pdh, mkl_pdh)
f_push(levels, show_pdl, mkl_pdl)
f_push(levels, show_pdc, mkl_pdc)
f_push(levels, show_pdo, mkl_pdo)
f_push(levels, show_pwh, mkl_pwh)
f_push(levels, show_pwl, mkl_pwl)
f_push(levels, show_cwo, mkl_cwo)
f_push(levels, show_pivot and show_r2, mkl_r2)
f_push(levels, show_pivot and show_r1, mkl_r1)
f_push(levels, show_pivot and show_pp, mkl_pp)
f_push(levels, show_pivot and show_s1, mkl_s1)
f_push(levels, show_pivot and show_s2, mkl_s2)
f_push(levels, show_tokyo_box, tokyoH)
f_push(levels, show_tokyo_box, tokyoL)
f_push(levels, show_london_box, londonH)
f_push(levels, show_london_box, londonL)
f_push(levels, show_ny_box, nyH)
f_push(levels, show_ny_box, nyL)
if show_round
    float rb = math.round(close / round_step) * round_step
    for i = -2 to 2
        float rlv = rb + i * round_step
        if rlv > 0
            array.push(levels, rlv)

n_lv = array.size(levels)

// ① ヒゲ反転
body = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low

float sell_wick_lv = na
float buy_wick_lv = na
if use_wick and n_lv > 0
    for i = 0 to n_lv - 1
        float lv = array.get(levels, i)
        if f_touch_sell(high, close, lv, tol, pierce) and upper_wick >= body * wick_ratio and upper_wick >= atr * wick_min
            if na(sell_wick_lv) or math.abs(high - lv) < math.abs(high - sell_wick_lv)
                sell_wick_lv := lv
        if f_touch_buy(low, close, lv, tol, pierce) and lower_wick >= body * wick_ratio and lower_wick >= atr * wick_min
            if na(buy_wick_lv) or math.abs(low - lv) < math.abs(low - buy_wick_lv)
                buy_wick_lv := lv

// ② ダブルトップ / ダブルボトム
ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)
var float prev_ph = na
var int prev_ph_bar = na
var float prev_pl = na
var int prev_pl_bar = na

float sell_dbl_lv = na
float buy_dbl_lv = na

if not na(ph)
    int cur_bar = bar_index - pivot_len
    if use_dbl and n_lv > 0 and not na(prev_ph) and cur_bar - prev_ph_bar <= dbl_lookback
        int span = bar_index - prev_ph_bar
        float valley = low
        for k = pivot_len to span
            valley := math.min(valley, low[k])
        if math.min(ph, prev_ph) - valley >= atr * dbl_depth
            for i = 0 to n_lv - 1
                float lv = array.get(levels, i)
                if ph >= lv - tol and ph <= lv + pierce and prev_ph >= lv - tol and prev_ph <= lv + pierce and close < lv
                    if na(sell_dbl_lv) or math.abs(ph - lv) < math.abs(ph - sell_dbl_lv)
                        sell_dbl_lv := lv
    prev_ph := ph
    prev_ph_bar := cur_bar

if not na(pl)
    int cur_bar = bar_index - pivot_len
    if use_dbl and n_lv > 0 and not na(prev_pl) and cur_bar - prev_pl_bar <= dbl_lookback
        int span = bar_index - prev_pl_bar
        float peak = high
        for k = pivot_len to span
            peak := math.max(peak, high[k])
        if peak - math.max(pl, prev_pl) >= atr * dbl_depth
            for i = 0 to n_lv - 1
                float lv = array.get(levels, i)
                if pl <= lv + tol and pl >= lv - pierce and prev_pl <= lv + tol and prev_pl >= lv - pierce and close > lv
                    if na(buy_dbl_lv) or math.abs(pl - lv) < math.abs(pl - buy_dbl_lv)
                        buy_dbl_lv := lv
    prev_pl := pl
    prev_pl_bar := cur_bar

// ③ 抜け失敗
float sell_fail_lv = na
float buy_fail_lv = na
if use_fail and n_lv > 0 and not na(away)
    for i = 0 to n_lv - 1
        float lv = array.get(levels, i)
        if close < lv and lv - close >= away and lv - close[1] < away
            int touches = 0
            bool broke = false
            for k = 1 to fail_lookback
                if close[k] >= lv
                    broke := true
                if f_touch_sell(high[k], close[k], lv, tol, pierce) and not f_touch_sell(high[k + 1], close[k + 1], lv, tol, pierce)
                    touches += 1
            if touches >= fail_touches and not broke
                if na(sell_fail_lv) or (lv - close) < (sell_fail_lv - close)
                    sell_fail_lv := lv
        if close > lv and close - lv >= away and close[1] - lv < away
            int touches = 0
            bool broke = false
            for k = 1 to fail_lookback
                if close[k] <= lv
                    broke := true
                if f_touch_buy(low[k], close[k], lv, tol, pierce) and not f_touch_buy(low[k + 1], close[k + 1], lv, tol, pierce)
                    touches += 1
            if touches >= fail_touches and not broke
                if na(buy_fail_lv) or (close - lv) < (close - buy_fail_lv)
                    buy_fail_lv := lv

// 統合・クールダウン
var float last_sell_lv = na
var int last_sell_bar = na
var float last_buy_lv = na
var int last_buy_bar = na

float sell_lv = not na(sell_dbl_lv) ? sell_dbl_lv : not na(sell_fail_lv) ? sell_fail_lv : sell_wick_lv
float buy_lv = not na(buy_dbl_lv) ? buy_dbl_lv : not na(buy_fail_lv) ? buy_fail_lv : buy_wick_lv

bool sell_ok = use_sig and not na(sell_lv) and barstate.isconfirmed
if sell_ok and not na(last_sell_lv) and math.abs(sell_lv - last_sell_lv) <= tol and bar_index - last_sell_bar < cooldown
    sell_ok := false
if sell_ok
    last_sell_lv := sell_lv
    last_sell_bar := bar_index

bool buy_ok = use_sig and not na(buy_lv) and barstate.isconfirmed
if buy_ok and not na(last_buy_lv) and math.abs(buy_lv - last_buy_lv) <= tol and bar_index - last_buy_bar < cooldown
    buy_ok := false
if buy_ok
    last_buy_lv := buy_lv
    last_buy_bar := bar_index

sig_sell_dbl = sell_ok and not na(sell_dbl_lv)
sig_sell_fail = sell_ok and not sig_sell_dbl and not na(sell_fail_lv)
sig_sell_wick = sell_ok and not sig_sell_dbl and not sig_sell_fail
sig_buy_dbl = buy_ok and not na(buy_dbl_lv)
sig_buy_fail = buy_ok and not sig_buy_dbl and not na(buy_fail_lv)
sig_buy_wick = buy_ok and not sig_buy_dbl and not sig_buy_fail

plotshape(sig_sell_wick, "売り:ヒゲ", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="ヒゲ", textcolor=#ff1744)
plotshape(sig_sell_dbl, "売り:ダブルトップ", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="DT", textcolor=#ff1744)
plotshape(sig_sell_fail, "売り:抜け失敗", style=shape.arrowdown, location=location.abovebar, color=#ff1744, size=size.small, text="失敗", textcolor=#ff1744)
plotshape(sig_buy_wick, "買い:ヒゲ", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="ヒゲ", textcolor=#00e676)
plotshape(sig_buy_dbl, "買い:ダブルボトム", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="DB", textcolor=#00e676)
plotshape(sig_buy_fail, "買い:抜け失敗", style=shape.arrowup, location=location.belowbar, color=#00e676, size=size.small, text="失敗", textcolor=#00e676)

alertcondition(sig_sell_wick or sig_sell_dbl or sig_sell_fail, "節目 売りサイン", "節目: 売りサイン")
alertcondition(sig_buy_wick or sig_buy_dbl or sig_buy_fail, "節目 買いサイン", "節目: 買いサイン")

// ══════════════════════════════════════════════════════════════
// 【追加】相場の節目自動表示 — ライン＆ラベル描画
// ══════════════════════════════════════════════════════════════
var line l_pdh = na
var line l_pdl = na
var line l_pdc = na
var line l_pdo = na
var line l_pwh = na
var line l_pwl = na
var line l_cwo = na
var line l_r2  = na
var line l_r1  = na
var line l_pp  = na
var line l_s1  = na
var line l_s2  = na
var line l_tokyoH  = na
var line l_tokyoL  = na
var line l_londonH = na
var line l_londonL = na
var line l_nyH     = na
var line l_nyL     = na

var label lb_pdh = na
var label lb_pdl = na
var label lb_pdc = na
var label lb_pdo = na
var label lb_pwh = na
var label lb_pwl = na
var label lb_cwo = na
var label lb_r2  = na
var label lb_r1  = na
var label lb_pp  = na
var label lb_s1  = na
var label lb_s2  = na
var label lb_tokyoH  = na
var label lb_tokyoL  = na
var label lb_londonH = na
var label lb_londonL = na
var label lb_nyH     = na
var label lb_nyL     = na

var line[] round_lines = array.new_line()
var label[] round_labels = array.new_label()

if barstate.islast
    // 古いものを削除
    if not na(l_pdh)
        line.delete(l_pdh)
    if not na(l_pdl)
        line.delete(l_pdl)
    if not na(l_pdc)
        line.delete(l_pdc)
    if not na(l_pdo)
        line.delete(l_pdo)
    if not na(l_pwh)
        line.delete(l_pwh)
    if not na(l_pwl)
        line.delete(l_pwl)
    if not na(l_cwo)
        line.delete(l_cwo)
    if not na(l_r2)
        line.delete(l_r2)
    if not na(l_r1)
        line.delete(l_r1)
    if not na(l_pp)
        line.delete(l_pp)
    if not na(l_s1)
        line.delete(l_s1)
    if not na(l_s2)
        line.delete(l_s2)
    if not na(l_tokyoH)
        line.delete(l_tokyoH)
    if not na(l_tokyoL)
        line.delete(l_tokyoL)
    if not na(l_londonH)
        line.delete(l_londonH)
    if not na(l_londonL)
        line.delete(l_londonL)
    if not na(l_nyH)
        line.delete(l_nyH)
    if not na(l_nyL)
        line.delete(l_nyL)

    if not na(lb_pdh)
        label.delete(lb_pdh)
    if not na(lb_pdl)
        label.delete(lb_pdl)
    if not na(lb_pdc)
        label.delete(lb_pdc)
    if not na(lb_pdo)
        label.delete(lb_pdo)
    if not na(lb_pwh)
        label.delete(lb_pwh)
    if not na(lb_pwl)
        label.delete(lb_pwl)
    if not na(lb_cwo)
        label.delete(lb_cwo)
    if not na(lb_r2)
        label.delete(lb_r2)
    if not na(lb_r1)
        label.delete(lb_r1)
    if not na(lb_pp)
        label.delete(lb_pp)
    if not na(lb_s1)
        label.delete(lb_s1)
    if not na(lb_s2)
        label.delete(lb_s2)
    if not na(lb_tokyoH)
        label.delete(lb_tokyoH)
    if not na(lb_tokyoL)
        label.delete(lb_tokyoL)
    if not na(lb_londonH)
        label.delete(lb_londonH)
    if not na(lb_londonL)
        label.delete(lb_londonL)
    if not na(lb_nyH)
        label.delete(lb_nyH)
    if not na(lb_nyL)
        label.delete(lb_nyL)

    if array.size(round_lines) > 0
        for i = 0 to array.size(round_lines) - 1
            line.delete(array.get(round_lines, i))
            label.delete(array.get(round_labels, i))
        array.clear(round_lines)
        array.clear(round_labels)

    // 新しく描画
    if show_pdh and not na(mkl_pdh)
        l_pdh  := line.new(bar_index, mkl_pdh, bar_index + 1, mkl_pdh, color=#ff5252, width=mkl_line_width, extend=extend.right)
        lb_pdh := label.new(bar_index + 2, mkl_pdh, "前日高値  " + str.tostring(mkl_pdh, format.mintick), style=label.style_label_left, color=color.new(#ff5252, 15), textcolor=color.white, size=size.normal)

    if show_pdl and not na(mkl_pdl)
        l_pdl  := line.new(bar_index, mkl_pdl, bar_index + 1, mkl_pdl, color=#4caf50, width=mkl_line_width, extend=extend.right)
        lb_pdl := label.new(bar_index + 2, mkl_pdl, "前日安値  " + str.tostring(mkl_pdl, format.mintick), style=label.style_label_left, color=color.new(#4caf50, 15), textcolor=color.white, size=size.normal)

    if show_pdc and not na(mkl_pdc)
        l_pdc  := line.new(bar_index, mkl_pdc, bar_index + 1, mkl_pdc, color=#ffeb3b, width=mkl_line_width, extend=extend.right)
        lb_pdc := label.new(bar_index + 2, mkl_pdc, "前日終値  " + str.tostring(mkl_pdc, format.mintick), style=label.style_label_left, color=color.new(#ffeb3b, 15), textcolor=color.black, size=size.normal)

    if show_pdo and not na(mkl_pdo)
        l_pdo  := line.new(bar_index, mkl_pdo, bar_index + 1, mkl_pdo, color=#90caf9, width=mkl_line_width, extend=extend.right)
        lb_pdo := label.new(bar_index + 2, mkl_pdo, "前日始値  " + str.tostring(mkl_pdo, format.mintick), style=label.style_label_left, color=color.new(#90caf9, 15), textcolor=color.white, size=size.normal)

    if show_pwh and not na(mkl_pwh)
        l_pwh  := line.new(bar_index, mkl_pwh, bar_index + 1, mkl_pwh, color=#ff9800, width=mkl_line_width, extend=extend.right)
        lb_pwh := label.new(bar_index + 2, mkl_pwh, "前週高値  " + str.tostring(mkl_pwh, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    if show_pwl and not na(mkl_pwl)
        l_pwl  := line.new(bar_index, mkl_pwl, bar_index + 1, mkl_pwl, color=#ff9800, width=mkl_line_width, extend=extend.right)
        lb_pwl := label.new(bar_index + 2, mkl_pwl, "前週安値  " + str.tostring(mkl_pwl, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    if show_cwo and not na(mkl_cwo)
        l_cwo  := line.new(bar_index, mkl_cwo, bar_index + 1, mkl_cwo, color=#ffeb3b, width=mkl_line_width, extend=extend.right)
        lb_cwo := label.new(bar_index + 2, mkl_cwo, "今週始値  " + str.tostring(mkl_cwo, format.mintick), style=label.style_label_left, color=color.new(#ffeb3b, 15), textcolor=color.black, size=size.normal)

    if show_pivot
        if show_r2 and not na(mkl_r2)
            l_r2  := line.new(bar_index, mkl_r2, bar_index + 1, mkl_r2, color=#f44336, width=mkl_line_width, extend=extend.right)
            lb_r2 := label.new(bar_index + 2, mkl_r2, "ピボットR2  " + str.tostring(mkl_r2, format.mintick), style=label.style_label_left, color=color.new(#f44336, 15), textcolor=color.white, size=size.normal)
        if show_r1 and not na(mkl_r1)
            l_r1  := line.new(bar_index, mkl_r1, bar_index + 1, mkl_r1, color=#ef5350, width=mkl_line_width, extend=extend.right)
            lb_r1 := label.new(bar_index + 2, mkl_r1, "ピボットR1  " + str.tostring(mkl_r1, format.mintick), style=label.style_label_left, color=color.new(#ef5350, 15), textcolor=color.white, size=size.normal)
        if show_pp and not na(mkl_pp)
            l_pp  := line.new(bar_index, mkl_pp, bar_index + 1, mkl_pp, color=#ffffff, width=mkl_line_width, extend=extend.right)
            lb_pp := label.new(bar_index + 2, mkl_pp, "ピボットPP  " + str.tostring(mkl_pp, format.mintick), style=label.style_label_left, color=color.new(#ffffff, 15), textcolor=color.black, size=size.normal)
        if show_s1 and not na(mkl_s1)
            l_s1  := line.new(bar_index, mkl_s1, bar_index + 1, mkl_s1, color=#66bb6a, width=mkl_line_width, extend=extend.right)
            lb_s1 := label.new(bar_index + 2, mkl_s1, "ピボットS1  " + str.tostring(mkl_s1, format.mintick), style=label.style_label_left, color=color.new(#66bb6a, 15), textcolor=color.white, size=size.normal)
        if show_s2 and not na(mkl_s2)
            l_s2  := line.new(bar_index, mkl_s2, bar_index + 1, mkl_s2, color=#43a047, width=mkl_line_width, extend=extend.right)
            lb_s2 := label.new(bar_index + 2, mkl_s2, "ピボットS2  " + str.tostring(mkl_s2, format.mintick), style=label.style_label_left, color=color.new(#43a047, 15), textcolor=color.white, size=size.normal)

    if show_tokyo_box
        if not na(tokyoH)
            l_tokyoH  := line.new(bar_index, tokyoH, bar_index + 1, tokyoH, color=#00bcd4, width=mkl_line_width, extend=extend.right)
            lb_tokyoH := label.new(bar_index + 2, tokyoH, "東京高値  " + str.tostring(tokyoH, format.mintick), style=label.style_label_left, color=color.new(#00bcd4, 15), textcolor=color.white, size=size.normal)
        if not na(tokyoL)
            l_tokyoL  := line.new(bar_index, tokyoL, bar_index + 1, tokyoL, color=#00bcd4, width=mkl_line_width, extend=extend.right)
            lb_tokyoL := label.new(bar_index + 2, tokyoL, "東京安値  " + str.tostring(tokyoL, format.mintick), style=label.style_label_left, color=color.new(#00bcd4, 15), textcolor=color.white, size=size.normal)

    if show_london_box
        if not na(londonH)
            l_londonH  := line.new(bar_index, londonH, bar_index + 1, londonH, color=#ff9800, width=mkl_line_width, extend=extend.right)
            lb_londonH := label.new(bar_index + 2, londonH, "ロンドン高値  " + str.tostring(londonH, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)
        if not na(londonL)
            l_londonL  := line.new(bar_index, londonL, bar_index + 1, londonL, color=#ff9800, width=mkl_line_width, extend=extend.right)
            lb_londonL := label.new(bar_index + 2, londonL, "ロンドン安値  " + str.tostring(londonL, format.mintick), style=label.style_label_left, color=color.new(#ff9800, 15), textcolor=color.white, size=size.normal)

    if show_ny_box
        if not na(nyH)
            l_nyH  := line.new(bar_index, nyH, bar_index + 1, nyH, color=#7e57c2, width=mkl_line_width, extend=extend.right)
            lb_nyH := label.new(bar_index + 2, nyH, "NY高値  " + str.tostring(nyH, format.mintick), style=label.style_label_left, color=color.new(#7e57c2, 15), textcolor=color.white, size=size.normal)
        if not na(nyL)
            l_nyL  := line.new(bar_index, nyL, bar_index + 1, nyL, color=#7e57c2, width=mkl_line_width, extend=extend.right)
            lb_nyL := label.new(bar_index + 2, nyL, "NY安値  " + str.tostring(nyL, format.mintick), style=label.style_label_left, color=color.new(#7e57c2, 15), textcolor=color.white, size=size.normal)

    if show_round
        float base = math.round(close / round_step) * round_step
        for i = -round_count to round_count
            float level = base + i * round_step
            if level > 0
                line ln = line.new(bar_index, level, bar_index + 1, level, color=round_color, width=1, extend=extend.right, style=line.style_dotted)
                label lb = label.new(bar_index + 2, level, str.tostring(level, "#"), style=label.style_label_left, color=color.new(round_color, 70), textcolor=color.gray, size=size.small)
                array.push(round_lines, ln)
                array.push(round_labels, lb)
